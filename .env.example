APP_ENV=production
APP_PORT=8080
DB_HOST=db
DB_PORT=5432
DB_NAME=weather
DB_USER=weather
DB_PASSWORD=weather

# Required for the WeatherAPI adapter. Obtain a free key at weatherapi.com.
WEATHERAPI_KEY=

# A starter location is inserted on first migration. Change to your field.
SEED_LOCATION_NAME=Demo field
SEED_LOCATION_LATITUDE=37.9838
SEED_LOCATION_LONGITUDE=23.7275
SEED_LOCATION_TIMEZONE=Europe/Athens
